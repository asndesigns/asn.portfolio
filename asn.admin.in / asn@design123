function bindTilt(){
  if(matchMedia("(hover:none)").matches || db.appearance.animation==="reduced") return;
  const intense=db.appearance.animation==="playful"?10:6;
  document.querySelectorAll(".pcard").forEach(c=>{
    c.onmousemove=e=>{
      const r=c.getBoundingClientRect();const x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
      c.style.transform=`translateY(-7px) perspective(900px) rotateX(${-y*intense}deg) rotateY(${x*(intense+2)}deg)`
    };
    c.onmouseleave=()=>c.style.transform=""
  })
}
