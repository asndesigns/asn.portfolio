function load(){try{const s=localStorage.getItem(KEY);if(!s)return clone(DEFAULT);const p=JSON.parse(s);return {...clone(DEFAULT),...p,profile:{...DEFAULT.profile,...(p.profile||{})},appearance:{...DEFAULT.appearance,...(p.appearance||{})}}}catch(e){return clone(DEFAULT)}}
function save(msg){try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){notify("Storage full — could not save");return}renderAll();if(msg)notify(msg)}
function esc(v=""){return String(v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]))}
function safeUrl(v=""){try{const u=new URL(v,location.href);return ["http:","https:"].includes(u.protocol)?u.href:""}catch(e){return""}}
function notify(m){document.getElementById("toastMsg").textContent=m;const t=document.getElementById("toast");t.classList.add("show");clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove("show"),3200)}
function applyAppearance(){
  const a=db.appearance;
  document.documentElement.style.setProperty('--blue',a.primary);
  document.documentElement.style.setProperty('--lime',a.accent);
  document.documentElement.style.setProperty('--r',a.radius+"px");
  document.documentElement.style.setProperty('--heading',`"${a.headingFont}", sans-serif`);
  document.documentElement.style.setProperty('--body',`"${a.bodyFont}", sans-serif`);
  document.body.style.fontFamily=`"${a.bodyFont}", system-ui, sans-serif`;
  const isDark=a.mode==="dark";
  document.body.classList.toggle("is-dark",isDark);
  if(isDark){
    document.documentElement.style.setProperty('--paper','#0a1026');
    document.documentElement.style.setProperty('--card','#141c38');
    document.documentElement.style.setProperty('--line','#1f2a4a');
    document.documentElement.style.setProperty('--ink','#eaf0ff');
    document.documentElement.style.setProperty('--muted','#9aa8c7');
  }else{
    document.documentElement.style.setProperty('--paper',a.bg);
    document.documentElement.style.setProperty('--card','#ffffff');
    document.documentElement.style.setProperty('--line','#e6e8ef');
    document.documentElement.style.setProperty('--ink','#111624');
    document.documentElement.style.setProperty('--muted','#66708a');
  }
  document.querySelectorAll('.preset').forEach(b=>b.classList.toggle('active',b.dataset.preset===a.preset));
