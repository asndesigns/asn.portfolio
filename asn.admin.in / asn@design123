    if(db.appearance.animation==="reduced") return;
    const r=b.getBoundingClientRect();
    b.style.transform=`translate(${(e.clientX-r.left-r.width/2)*.1}px,${(e.clientY-r.top-r.height/2)*.16}px)`
  });
  b.addEventListener("mouseleave",()=>b.style.transform="")
});
const dot=document.getElementById("cursorDot"),ring=document.getElementById("cursorRing");
addEventListener("mousemove",e=>{
  if(db.appearance.animation==="reduced") return;
  dot.style.left=e.clientX+"px";dot.style.top=e.clientY+"px";
  ring.style.left=e.clientX+"px";ring.style.top=e.clientY+"px";
},{passive:true});
document.addEventListener("mouseover",e=>{
  const hot=e.target.closest("a,button,.pcard");
  ring.style.width=hot?"54px":"36px";ring.style.height=hot?"54px":"36px";
  ring.style.background=hot?"rgba(216,255,46,.14)":"transparent"
});
const art=document.getElementById("heroArt");
if(art&&matchMedia("(hover:hover)").matches){
  document.querySelector(".hero").addEventListener("mousemove",e=>{
    if(db.appearance.animation==="reduced") return;
    const x=(e.clientX/innerWidth-.5)*12,y=(e.clientY/innerHeight-.5)*9;
    art.style.transform=`translate(${x}px,${y}px)`
  })
}
(function(){
  const p=document.getElementById("linePath");if(!p)return;
  const L=p.getTotalLength();p.style.strokeDasharray=L;p.style.strokeDashoffset=L;
  setTimeout(()=>{p.style.transition="stroke-dashoffset 2.2s ease";p.style.strokeDashoffset="0"},900);
})();
(function(){
  let n=0;const f=document.getElementById("preFill"),t=document.getElementById("preNum");
  const iv=setInterval(()=>{
    n=Math.min(100,n+Math.random()*16);
    f.style.width=n+"%";
    t.textContent=`LOADING — ${Math.floor(n)}%`;
    if(n>=100){clearInterval(iv);setTimeout(()=>document.getElementById("preloader").classList.add("done"),340)}
  },130);
})();
renderAll();observeReveals();setInterval(observeReveals,800);
</script>
</body>
</html>
