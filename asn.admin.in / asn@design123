}
function renderFilters(){
  const box=document.getElementById("filters");
  const counts={All:db.projects.length};
  db.genres.forEach(g=>counts[g]=db.projects.filter(p=>p.category===g).length);
  let h=`<button class="fbtn ${curCat==="All"?"active":""}" data-cat="All">All work <span class="c">${counts.All}</span></button>`;
  h+=db.genres.map(g=>`<button class="fbtn ${curCat===g?"active":""}" data-cat="${esc(g)}">${esc(g)} <span class="c">${counts[g]||0}</span></button>`).join("");
  box.innerHTML=h;
}
function filtered(){
  let list=db.projects.filter(p=>{
    const t=[p.title,p.shortDesc,p.tools,p.client].join(" ").toLowerCase();
    return (curCat==="All"||p.category===curCat)&&t.includes(curQ.toLowerCase())
  });
  if(curSort==="az") list=[...list].sort((a,b)=>a.title.localeCompare(b.title));
  else if(curSort==="feat") list=[...list].sort((a,b)=>(b.featured?1:0)-(a.featured?1:0));
  return list;
}
function renderProjects(){
  const g=document.getElementById("projectsGrid");
